# Copy to .env (never commit .env). On Vercel, add these in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=your-key-here

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5        # coach + chat
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5    # quick-add + categorize
# ALLOWED_ORIGINS=https://your-domain.com  # extra origins allowed to call /api/ai (same-origin always works)
# RATE_LIMIT_PER_MIN=15
